{
  "name": "umbral-live-fx",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.9.0", "npm": ">=10" },
  "scripts": {
    "dev": "npm run dev --workspace=@umbral/web --",
    "build": "npm run build --workspace=@umbral/web --",
    "start": "npm run start --workspace=@umbral/web --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3"
  }
}
